<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Headline with live indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next Up"
            android:textColor="#6366F1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="marquee"
            android:singleLine="true" />

        <!-- Live pulse indicator (visible only when live) -->
        <TextView
            android:id="@+id/widget_live_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:visibility="gone"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- Subline (subject · time · room) -->
    <TextView
        android:id="@+id/widget_subline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading schedule..."
        android:textColor="#333333"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_marginBottom="6dp" />

    <!-- Teacher info (if available) -->
    <TextView
        android:id="@+id/widget_teacher_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#666666"
        android:textSize="11sp"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- Progress bar (only if class is live) -->
    <ProgressBar
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        style="@android:style/Widget.ProgressBar.Horizontal" />

    <!-- Time info (in Xh Xm, Xmin left, etc.) -->
    <TextView
        android:id="@+id/widget_time_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="#888888"
        android:textSize="11sp"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
