<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Premium Dark Obsidian Background Card with Glowing Neon Rim -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark_v2" />

    <!-- 1. Compact Single-Bar View (Active when height < 105dp) -->
    <LinearLayout
        android:id="@+id/widget_compact_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_compact_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_pill_badge_live" />

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="CS-301 • Room B7"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_compact_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32m left"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Standard / Full Luxury View (Matching Reference Mockups) -->
    <LinearLayout
        android:id="@+id/widget_full_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="7dp">

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE LECTURE"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="3.5dp"
                android:paddingBottom="3.5dp"
                android:background="@drawable/widget_pill_badge_live" />

            <TextView
                android:id="@+id/widget_state_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Inner Floating Frosted Hero Card -->
        <LinearLayout
            android:id="@+id/widget_hero_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_hero_card_dark"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="8dp">

            <!-- Big Bold Hero Number/Countdown -->
            <TextView
                android:id="@+id/widget_time_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32m REMAINING"
                android:textColor="#38BDF8"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="3dp" />

            <!-- Subject Headline -->
            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS301: Object Oriented Programming"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- Subline: Instructor & Room -->
            <TextView
                android:id="@+id/widget_subline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prof. Hamza Arif • Room B7"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Live Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/widget_progress"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:max="100"
                android:progress="68"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Pill Action Button -->
        <LinearLayout
            android:id="@+id/widget_action_button"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_action_pill_dark">

            <TextView
                android:id="@+id/widget_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Route Map"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
