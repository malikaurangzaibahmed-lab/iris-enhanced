<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_background_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT CLASS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FF1D4ED8"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_pill_badge" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Uppercase Category Label -->
        <TextView
            android:id="@+id/widget_state_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIMETABLE INSIGHT"
            android:textColor="#334155"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="2dp" />

        <!-- Bold Class Title -->
        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBJECT ORIENTED PROGRAMMING"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Details Capsule (Start Time & Room) -->
        <LinearLayout
            android:id="@+id/widget_class_details_capsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_details_capsule"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_details_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM"
                android:textColor="#0F172A"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/widget_details_divider"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="#94A3B8" />

            <ImageView
                android:id="@+id/widget_details_loc_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/widget_ic_loc" />

            <TextView
                android:id="@+id/widget_details_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room C1.2"
                android:textColor="#0F172A"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Instructor Card -->
        <LinearLayout
            android:id="@+id/widget_teacher_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_translucent_subcard"
            android:padding="6dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/widget_teacher_avatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/widget_ic_teacher_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_teacher_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INSTRUCTOR"
                    android:textColor="#6D28D9"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_teacher_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Instructor Name"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:progressDrawable="@drawable/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <!-- Footer Time Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_clock_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/widget_ic_clock" />

            <TextView
                android:id="@+id/widget_time_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starts in 15 mins"
                android:textColor="#1E40AF"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
