<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Premium Background Card -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light_v2" />

    <!-- 1. Compact Single-Bar View (Active when height < 105dp) -->
    <LinearLayout
        android:id="@+id/widget_compact_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_compact_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_badge_live" />

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="CS-301 • Room C1.2"
            android:textColor="#0F172A"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_compact_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45m left"
            android:textColor="#4F46E5"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Standard / Full View (Active when height >= 105dp) -->
    <LinearLayout
        android:id="@+id/widget_full_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT CLASS"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_badge_next" />

            <TextView
                android:id="@+id/widget_state_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="TIMETABLE INSIGHT"
                android:textColor="#64748B"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Course Title Headline -->
        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBJECT ORIENTED PROGRAMMING"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="3dp" />

        <!-- Details Capsule (Room & Start Time) -->
        <LinearLayout
            android:id="@+id/widget_class_details_capsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_details_capsule_v2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_details_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/widget_details_divider"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="#CBD5E1" />

            <ImageView
                android:id="@+id/widget_details_loc_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/widget_ic_loc" />

            <TextView
                android:id="@+id/widget_details_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room C1.2"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Instructor Subcard -->
        <LinearLayout
            android:id="@+id/widget_teacher_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_subcard_v2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="3dp">

            <ImageView
                android:id="@+id/widget_teacher_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginRight="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_ic_teacher_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_teacher_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INSTRUCTOR"
                    android:textColor="#6D28D9"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_teacher_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Instructor Name"
                    android:textColor="#1E293B"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Live Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:progressDrawable="@drawable/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="3dp" />

        <!-- Time Info & Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_clock_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/widget_ic_clock" />

            <TextView
                android:id="@+id/widget_time_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starts in 15 mins"
                android:textColor="#4F46E5"
                android:textStyle="bold"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
