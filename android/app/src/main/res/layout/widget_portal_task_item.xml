<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_subcard_v2"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Left Side Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginRight="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- Task Type Pill Badge -->
            <TextView
                android:id="@+id/task_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSIGNMENT"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_badge_next" />

            <!-- Course Title / Tag -->
            <TextView
                android:id="@+id/task_course_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="CS-301"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Task Title -->
        <TextView
            android:id="@+id/task_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assignment #2 - Binary Trees Implementation"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Side Due Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/task_due_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Today"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_details_capsule_v2" />

        <TextView
            android:id="@+id/task_due_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="11:59 PM"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#64748B" />
    </LinearLayout>
</LinearLayout>
